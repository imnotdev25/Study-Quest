# --- dependencies ---
node_modules/
.pnpm-store/

# --- build output ---
# Excalidraw fonts, copied from node_modules at build time
public/fonts/
dist/
src-tauri/target/
src-tauri/gen/

# Icons are generated from src-tauri/icons/source.png by `pnpm tauri icon` (CI does this too).
src-tauri/icons/*
!src-tauri/icons/source.png

# --- Python / marimo ---
.venv/
uv.lock
__pycache__/
*.py[cod]
.ipynb_checkpoints/
__marimo__/
notebooks/**/__marimo__/

# --- graphify knowledge graph (local tooling) ---
graphify-out/

# --- logs, caches, editors, OS ---
*.log
npm-debug.log*
pnpm-debug.log*
.vite/
.cache/
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# --- secrets: never commit ---
.env
.env.*
!.env.example
*.pem
*.p12
*.key

# NOTE: public/content/, public/figs/ and notebooks/ are generated by `pnpm content`
# but ARE committed on purpose: CI builds the app without pandoc, tectonic or the Python venvs.
